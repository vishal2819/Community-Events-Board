generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  MUSIC
  WORKSHOP
  FOOD
  SPORTS
  KIDS
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique @db.VarChar(254)
  passwordHash String            @db.VarChar(100)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  favourites   FavouriteCategory[]
  reminders    EventReminder[]
  designs      EventCardDesign[]
}

model Event {
  id          String            @id @default(uuid()) @db.Uuid
  title       String            @db.VarChar(120)
  category    Category
  city        String            @db.VarChar(80)
  startsAt    DateTime          @db.Timestamptz(3)
  price       Decimal           @db.Decimal(10, 2)
  description String            @db.VarChar(4000)
  imageUrl    String?           @db.VarChar(2048)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  reminders   EventReminder[]
  designs     EventCardDesign[]

  @@index([isActive, startsAt, id])
  @@index([category, isActive, startsAt])
}

model FavouriteCategory {
  userId   String   @db.Uuid
  category Category
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

model EventReminder {
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model EventCardDesign {
  userId    String   @db.Uuid
  eventId   String   @db.Uuid
  theme     String   @db.VarChar(32)
  stickers  String[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}
