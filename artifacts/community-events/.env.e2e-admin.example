# Local-only credentials for the Playwright browser suite. Copy to .env.e2e-admin
# and fill in, then run `pnpm test:e2e` from artifacts/community-events.
#
# These live outside .env on purpose: Next.js expands `$name` references while
# loading .env, which corrupts a bcrypt hash and makes admin login fail with 503.
# This file is parsed with dotenv directly, so the hash survives intact, and the
# suite injects these values into the web server's environment.
#
# This file is gitignored. Never commit it.

# Generate with: pnpm admin:hash
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-a-bcrypt-cost-12-or-higher-hash"
# The plaintext that matches the hash above, needed to sign in. Gitignored.
ADMIN_PASSWORD="replace-with-the-matching-plaintext-password"