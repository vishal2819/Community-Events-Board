# DATABASE_URL is provided automatically in Replit; use your own local Postgres elsewhere.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/civic"
# At least 32 cryptographically random bytes; never NEXT_PUBLIC_.
JWT_SECRET="replace-with-a-random-secret"
ADMIN_EMAIL="admin@example.com"
# Generate through pnpm admin:hash. A bcrypt hash, not a plaintext password.
ADMIN_PASSWORD_HASH="replace-with-bcrypt-cost-12-hash"
