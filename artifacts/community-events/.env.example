# Copy to .env and fill in. This file must never contain real secrets in git.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/civic"

# At least 32 cryptographically random bytes; never NEXT_PUBLIC_.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Admin credentials are deliberately NOT configured here.
#
# A bcrypt hash always begins `$2b$12$`. Next.js expands `$name` references while
# loading `.env`, and in this project that silently stripped the `$2b$12$` prefix,
# leaving a value the server rejects: every admin login returned 503 until the
# hash was supplied through the real process environment instead. Quoting the
# value (single or double) does not prevent the expansion.
#
# Supply the admin pair through the environment when starting the app:
#
#   bash : export ADMIN_EMAIL='admin@example.com'
#          export ADMIN_PASSWORD_HASH='$2b$12$...'
#
#   pwsh : $env:ADMIN_EMAIL='admin@example.com'
#          $env:ADMIN_PASSWORD_HASH='$2b$12$...'
#
# Generate the hash with `pnpm admin:hash`, which prompts with hidden input.
# Admin access stays disabled while either variable is unset.
# ---------------------------------------------------------------------------

# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD_HASH="replace-with-bcrypt-cost-12-hash"